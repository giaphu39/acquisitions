# ==============================================================================
# Application & Server Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration
# ==============================================================================
# Chuỗi kết nối PostgreSQL (Neon Cloud hoặc Neon Local Proxy)
# - Dùng Neon Cloud: postgresql://username:password@hostname/dbname?sslmode=require
# - Dùng Neon Local qua Docker: postgresql://neon:npg@neon-local:5432/neondb
# - Dùng Neon Local qua localhost: postgresql://neon:npg@localhost:5432/neondb
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# ==============================================================================
# Neon Local Configuration (Cần thiết khi chạy Docker dev với Neon Local)
# ==============================================================================
# Lấy từ Neon Console: Account Settings -> API Keys & Project Settings
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=main

# ==============================================================================
# Security & Authentication Configuration
# ==============================================================================
# Khóa bí mật ký JWT token cho môi trường dev
JWT_SECRET=your-development-jwt-secret-key-here

# Khóa Arcjet API để bảo vệ ứng dụng (Shield, Bot Detection, Rate Limiting)
ARCJET_KEY=your_arcjet_key_here
ARCJET_ENV=development
