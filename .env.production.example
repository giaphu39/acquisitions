# ==============================================================================
# Application & Server Configuration (Production)
# ==============================================================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ==============================================================================
# Database Configuration (Neon Cloud PostgreSQL)
# ==============================================================================
# Chuỗi kết nối Neon Cloud Production Database
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# ==============================================================================
# Security & Authentication Configuration
# ==============================================================================
# Khóa JWT an toàn cho môi trường Production (tối thiểu 32 ký tự)
JWT_SECRET=your-strong-production-jwt-secret-key-here

# Khóa bảo mật Arcjet môi trường Production
ARCJET_KEY=your_production_arcjet_key_here
ARCJET_ENV=production
